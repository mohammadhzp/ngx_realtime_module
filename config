ngx_addon_name="ngx_realtime_module"
HTTP_SRC="$ngx_addon_dir/ngx_http_realtime_module.c"

if [ $ngx_module_link = DYNAMIC ] ; then
    if [ $HTTP != NO ]; then
        ngx_module_name="$ngx_module_name ngx_http_realtime_module"
        ngx_module_srcs=$HTTP_SRC
        #ngx_module_libs=$LIBS
    fi

    . auto/module

else

    if [ $HTTP != NO ]; then
        ngx_module_type=HTTP
        ngx_module_name=ngx_http_realtime_module
        ngx_module_srcs=$HTTP_SRC
        #ngx_module_libs=$LIBS

        . auto/module
    fi
fi